 func (p *setnsProcess) start() (retErr error) {
 	defer p.comm.closeParent()
+	defer p.comm.closeChild() // also release log pipe on pre-spawn validation errors
+
+	// SONIC-OFFLINE FIX: The vendor device runs iSulad inside an outer chroot.
+	// Joining its container's mount namespace can select the namespace root
+	// (the host root), not the init process's chroot. Pin the init's actual
+	// root BEFORE setns, and restore it in single-threaded nsexec before
+	// credentials/seccomp/cwd are applied. Do not resolve /proc after setns:
+	// that procfs may describe a different PID namespace on this device.
+	if !p.container.hasInit() {
+		return errors.New("offline exec-root: container init is no longer alive")
+	}
+	procRoot, err := procfs.OpenProcRoot()
+	if err != nil {
+		return fmt.Errorf("offline exec-root: open trusted procfs: %w", err)
+	}
+	defer procRoot.Close()
+	procPID, err := procRoot.OpenPid(p.initProcessPid, ".")
+	if err != nil {
+		return fmt.Errorf("offline exec-root: open init proc directory: %w", err)
+	}
+	defer procPID.Close()
+	// Deliberately follow this one kernel-generated magic link. Generic
+	// safe-path helpers reject it; resolving a user-supplied path is forbidden.
+	rootFD, err := unix.Openat(int(procPID.Fd()), "root", unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("offline exec-root: pin init root: %w", err)
+	}
+	execRoot := os.NewFile(uintptr(rootFD), "container-init-root")
+	defer execRoot.Close() // parent's copy; child closes its copy before Go init
+	// hasInit checks the saved start time too, rejecting PID reuse while
+	// obtaining the root reference. Existing namespace checks remain intact.
+	if !p.container.hasInit() {
+		return errors.New("offline exec-root: container init changed while pinning root")
+	}
+	p.cmd.ExtraFiles = append(p.cmd.ExtraFiles, execRoot)
+	p.cmd.Env = append(p.cmd.Env, "_LIBCONTAINER_EXECROOTFD="+
+		strconv.Itoa(stdioFdCount+len(p.cmd.ExtraFiles)-1))
 
