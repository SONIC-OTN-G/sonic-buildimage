FROM --platform=linux/arm64 openeuler/openeuler:22.03-lts-sp4@sha256:f4f7b49430a7eec2f8dfd9d25d6d677cb81aa7ccbf2cd4cac70c4f9acc39f7ee
RUN yum install -y iSulad-2.1.5-10.oe2203sp4.aarch64 runc tar gzip util-linux findutils glibc-locale-source && yum clean all
RUN localedef -i en_US -f UTF-8 en_US.UTF-8 && localedef --no-archive -i en_US -f UTF-8 /usr/lib/locale/en_US.utf8
