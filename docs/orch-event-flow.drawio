            <mxPoint x="495" y="875" as="sourcePoint" />
            <mxPoint x="1320" y="875" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== 消息 ===== -->
        <mxCell id="msg-write" value="写入数据"
                style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=13;strokeWidth=2;labelBackgroundColor=#ffffff;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="170" as="sourcePoint" />
            <mxPoint x="500" y="170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-notify" value="推送变更通知"
                style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=13;strokeWidth=2;labelBackgroundColor=#ffffff;"
