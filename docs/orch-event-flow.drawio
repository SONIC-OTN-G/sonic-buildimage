          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="295" as="sourcePoint" />
            <mxPoint x="500" y="295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-reply" value="返回 key + 字段值"
                style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=13;strokeWidth=2;labelBackgroundColor=#ffffff;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="355" as="sourcePoint" />
            <mxPoint x="860" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-trigger" value="触发业务处理"
                style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=13;strokeWidth=2;labelBackgroundColor=#ffffff;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="475" as="sourcePoint" />
            <mxPoint x="1220" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-self-check" value=""
                style="html=1;endArrow=block;endFill=1;fontSize=13;strokeWidth=2;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1220" y="600" as="sourcePoint" />
            <mxPoint x="1220" y="645" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1300" y="600" />
              <mxPoint x="1300" y="645" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-action" value="执行动作&#xa;(写下游数据库 / 调用硬件接口)"
                style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=13;strokeWidth=2;labelBackgroundColor=#ffffff;"
                edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1220" y="770" as="sourcePoint" />
            <mxPoint x="500" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
