          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="230" as="sourcePoint" />
            <mxPoint x="860" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="msg-read" value="读取数据"
